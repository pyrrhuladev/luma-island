<Window x:Class="Luma.Island.HudEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки · Luma Island" Width="1120" Height="780" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#10151B"
        Foreground="#ECF1F7" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnSettingsKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorMint" Color="#9DE6D1"/>
        <SolidColorBrush x:Key="EditorMuted" Color="#A6B4C4"/>
        <SolidColorBrush x:Key="EditorWarning" Color="#F2C296"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EditorMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#232D38"/>
            <Setter Property="Foreground" Value="#ECF1F7"/>
            <Setter Property="BorderBrush" Value="#354452"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#607887"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource EditorMint}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#304050"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#19232E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource EditorMint}"/>
            <Setter Property="Foreground" Value="#102B25"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorMint}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B9F4E3"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#7CC9B5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="ToggleRow" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="7,4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="CheckSurface" Width="30" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Background="#273441" BorderBrush="#607285" BorderThickness="1" CornerRadius="9">
                            <Ellipse x:Name="CheckMark" Width="11" Height="11" Fill="#A6B4C4" Margin="2,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource EditorMint}"/>
                        <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource EditorMint}"/>
                        <Setter TargetName="CheckMark" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="CheckMark" Property="Fill" Value="#16342B"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleRow" Property="Background" Value="#242F3B"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleRow" Property="BorderBrush" Value="{StaticResource EditorMint}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,14,5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse x:Name="RadioSurface" Stroke="#718991" StrokeThickness="1" Fill="#18252A"/>
                        <Ellipse x:Name="RadioMark" Fill="#A6E8CF" Width="6" Height="6" Visibility="Collapsed"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="RadioSurface" Property="Stroke" Value="#A6E8CF"/>
                        <Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioSurface" Property="Stroke" Value="#C6FFE7"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioSurface" Property="Stroke" Value="#A6E8CF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                           Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="22" Margin="2,0">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="ThumbTrack" Background="#5A7080" CornerRadius="2.5" Width="5" HorizontalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbTrack" Property="Background" Value="#87A8AE"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30">
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" VerticalAlignment="Center" Background="#83CBB1" CornerRadius="2"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="15" Height="28" Cursor="Hand">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Ellipse Width="12" Height="12" Fill="#C1F2DF"/>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" VerticalAlignment="Center" Background="#3B4A53" CornerRadius="2"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#121A20"/>
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="BorderBrush" Value="#35434C"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="Foreground" Value="#E1E9ED"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#2B4640"/>
                            <Setter Property="Foreground" Value="#C5F3DF"/>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <ContentPresenter ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9DAEB8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,9,0,11" Margin="0,0,24,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#BEF0DA"/>
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#A6E8CF"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DrawingBrush x:Key="PreviewBackdrop" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#232F3D" Geometry="M0,0 H28 V28 H0 Z"/>
                <GeometryDrawing Brush="#283646" Geometry="M0,0 H14 V14 H0 Z M14,14 H28 V28 H14 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewLightBackdrop" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#C4CFDB" Geometry="M0,0 H28 V28 H0 Z"/>
                <GeometryDrawing Brush="#D4DEE8" Geometry="M0,0 H14 V14 H0 Z M14,14 H28 V28 H14 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#1B232B"/><Setter Property="BorderBrush" Value="#2D3944"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="18"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECF1F7"/><Setter Property="Background" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#364656"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#BEF0DA"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A6E8CF"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8F1F3"/><Setter Property="Background" Value="#17262E"/>
            <Setter Property="BorderBrush" Value="#354B56"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><ToggleButton Focusable="False" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="7">
                            <Grid Margin="10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                <Path Grid.Column="1" Data="M1,1 L5,5 L9,1" Stroke="#B6D2D1" StrokeThickness="1.3" Width="9" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                    <Border Background="#17262E" BorderBrush="#49616B" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A6E8CF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8F1F3"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ChoiceSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#2A4544"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#AEBEC6"/><Setter Property="Padding" Value="9,10"/>
            <Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavigationSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#232E39"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#223832"/><Setter Property="Foreground" Value="#C2F4E4"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="{StaticResource EditorMint}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationGlyph" TargetType="Path">
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.55"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            <Setter Property="Data" Value="M2,3 H14 V13 H2 Z M2,6 H14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="appearance"><Setter Property="Data" Value="M2,3 H14 V13 H2 Z M2,10 L6,6 L9,9 L11,7 L14,10"/></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="layout"><Setter Property="Data" Value="M2,2 H7 V14 H2 Z M9,2 H14 V7 H9 Z M9,9 H14 V14 H9 Z"/></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="components"><Setter Property="Data" Value="M1,13 H15 M3,11 V7 M7,11 V3 M11,11 V5"/></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="alerts"><Setter Property="Data" Value="M8,2 L15,14 H1 Z M8,6 V10 M8,11 V12"/></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="placement"><Setter Property="Data" Value="M3,1 H1 V4 M13,1 H15 V4 M1,12 V15 H4 M12,15 H15 V12 M8,5 V11 M5,8 H11"/></DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="profiles"><Setter Property="Data" Value="M2,6 Q2,4 5,4 H11 Q14,4 14,6 L15,11 Q15,14 12,12 L10,10 H6 L4,12 Q1,14 1,11 Z M3,7 H7 M5,5 V9 M10,7 H11 M12,8 H13"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="22,18,22,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#223832" Width="44" Height="44" CornerRadius="12" Margin="0,0,13,0">
                    <Path Width="21" Height="20" Stretch="Uniform" Data="M2,2 V15 H15 M10,7 H15 M12,10 H17"
                          Stroke="{StaticResource EditorMint}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUMA ISLAND" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource EditorMint}"/>
                    <TextBlock Text="Настройки" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,1"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="TogglePreviewButton" Grid.Column="1" Content="Предпросмотр" Click="OnTogglePreview" Margin="12,0" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#182720" BorderBrush="#2E493F" BorderThickness="1" CornerRadius="9"
                    Padding="11,6" VerticalAlignment="Center" MaxWidth="205">
                <StackPanel>
                    <TextBlock Text="ПРОФИЛЬ СОХРАНЕНИЯ" FontSize="9" FontWeight="SemiBold" Foreground="#A0BEB3"/>
                    <TextBlock x:Name="TargetNameText" Foreground="#C2F4E4" FontSize="13" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.Name="Куда сохраняются настройки"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="SettingsBody" Grid.Row="1" Margin="18,0" SizeChanged="OnSettingsBodySizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="194"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewGapColumn" Width="16"/><ColumnDefinition x:Name="PreviewColumn" Width="272"/>
            </Grid.ColumnDefinitions>
            <Border Background="#151D25" BorderBrush="#283540" BorderThickness="1" CornerRadius="13" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,2,0,9">
                        <Grid>
                            <TextBox x:Name="SettingsSearchBox" Padding="29,8,27,8" FontSize="13" MinHeight="36" MaxLength="128"
                                     TextChanged="OnSearchChanged" AutomationProperties.Name="Поиск разделов настроек" ToolTip="Поиск по названию или параметру · Ctrl+F"/>
                            <Path Data="M10,6 A4,4 0 1 1 2,6 A4,4 0 1 1 10,6 M9,9 L14,14" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{StaticResource EditorMuted}" StrokeThickness="1.45" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск настроек" Foreground="{StaticResource EditorMuted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="30,0,8,0" IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchButton" Content="×" FontSize="16" MinHeight="24" Width="24" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Click="OnClearSearch" AutomationProperties.Name="Очистить поиск" ToolTip="Очистить поиск (Esc)" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="SearchResultLabel" Text="РАЗДЕЛЫ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource EditorMuted}" Margin="8,13,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="SettingsNavigation" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}"
                                 SelectionChanged="OnNavigationChanged" AutomationProperties.Name="Разделы настроек">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource NavigationGlyph}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoSearchResults" Text="Совпадений нет. Попробуйте «FPS», «музыка» или «монитор»." Style="{StaticResource Caption}" Margin="8,10" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="SettingsContentPanel" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,2,0,16"><TextBlock x:Name="ActiveSectionTitle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActiveSectionDescription" Style="{StaticResource Caption}" Margin="0,5,8,0"/>
                </StackPanel>
                <TabControl x:Name="EditorTabs" Grid.Row="1" SelectionChanged="OnEditorTabChanged">
                    <TabItem x:Name="AppearanceTab" Header="Внешний вид"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel>
                            <TextBlock Text="Стекло" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                            <TextBlock Text="Прозрачность фона капсулы поверх игры и рабочего стола." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Прозрачность фона"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TransparencySlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="TransparencySlider" Minimum="0" Maximum="95" ValueChanged="OnDraftChanged"
                                    AutomationProperties.Name="Прозрачность фона, проценты"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Content="30%" Tag="30" Click="OnTransparencyPreset" MinWidth="54" Margin="0,0,6,0" ToolTip="Прозрачность 30%"/>
                                <Button Content="60%" Tag="60" Click="OnTransparencyPreset" MinWidth="54" Margin="0,0,6,0" ToolTip="Прозрачность 60%"/>
                                <Button Content="85%" Tag="85" Click="OnTransparencyPreset" MinWidth="54" ToolTip="Прозрачность 85%"/>
                            </WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Размер и интервалы" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Масштаб всего HUD"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="ScaleSlider" Minimum="75" Maximum="150" ValueChanged="OnDraftChanged" AutomationProperties.Name="Масштаб HUD, проценты"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Размер текста"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TextScaleSlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="TextScaleSlider" Minimum="80" Maximum="130" ValueChanged="OnDraftChanged" AutomationProperties.Name="Размер текста, проценты"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Расстояния между блоками"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0}}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="SpacingSlider" Minimum="2" Maximum="12" ValueChanged="OnDraftChanged" AutomationProperties.Name="Расстояния между блоками"/>

                        </StackPanel></Border></StackPanel>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="AlertsTab" Header="Предупреждения"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel>
                            <CheckBox x:Name="AlertsEnabledCheckBox" Content="Тихие предупреждения" FontSize="15" FontWeight="SemiBold" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <TextBlock Text="Цветной маркер появляется рядом с показателями HUD." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            </StackPanel></Border>
                            <StackPanel x:Name="AlertRulesPanel" IsEnabled="{Binding IsChecked, ElementName=AlertsEnabledCheckBox}">
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel>
                                <TextBlock Text="Температура" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertCpuCheckBox" Content="CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=CpuThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="CpuThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertCpuCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры CPU, градусы Цельсия"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertGpuCheckBox" Content="GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=GpuThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GpuThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertGpuCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры GPU, градусы Цельсия"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertMemoryCheckBox" Content="RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=MemoryThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="MemoryThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertMemoryCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры RAM, градусы Цельсия"/>
                                <TextBlock Text="Маркер появляется, когда температура держится выше порога несколько секунд."
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="Просадки в игре" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="AlertStuttersCheckBox" Content="Серия задержавшихся кадров" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=AlertStuttersCheckBox}">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Кадр дольше"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FrameThresholdSlider, StringFormat={}{0:0} мс}" Foreground="#BEEBD6"/>
                                    </Grid>
                                    <Slider x:Name="FrameThresholdSlider" Minimum="10" Maximum="250" ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог времени кадра, миллисекунды"/>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Таких кадров за 2 секунды"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=StutterCountSlider, StringFormat={}{0:0}}" Foreground="#BEEBD6"/>
                                    </Grid>
                                    <Slider x:Name="StutterCountSlider" Minimum="2" Maximum="10" LargeChange="1" ValueChanged="OnDraftChanged" AutomationProperties.Name="Количество медленных кадров за две секунды"/>
                                </StackPanel>
                                </StackPanel></Border>
                            </StackPanel>
                            <Border Background="#17232B" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <TextBlock Text="Включённые правила используют соответствующие измерения, даже если сами числа скрыты. Частота опроса остаётся прежней. Датчики CPU / RAM требуют настроенного модуля датчиков."
                                           Style="{StaticResource Caption}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="LayoutTab" Header="Раскладка"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                        <Border x:Name="CapsuleLayoutCard" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Visibility="Collapsed"><StackPanel>
                            <TextBlock Text="Интерактивная раскладка" Style="{StaticResource Section}" Margin="0,0,0,5"/>
                            <TextBlock Text="Порядок и положение блоков меняются прямо на экране. Откройте «Редактировать HUD…» в меню капсулы или трея." Style="{StaticResource Caption}"/>
                        </StackPanel></Border>
                        <Border x:Name="LegacyIslandsCard" Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Отдельные островки" Style="{StaticResource Section}" Margin="0,0,0,5"/>
                            <TextBlock Text="Вынесите плеер в своё окно и перетащите его в удобное место." Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                            <CheckBox x:Name="DetachedMusicCheckBox" Content="Музыка и громкость в отдельном островке" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <TextBlock Text="Оформление, закрепление и горячие клавиши общие для обоих островков." Style="{StaticResource Caption}" Margin="0,7,0,10"/>
                            <Button x:Name="ResetMusicPositionButton" Content="Сбросить положение музыки" Click="OnResetMusicPosition" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecked, ElementName=DetachedMusicCheckBox}" ToolTip="После сохранения музыкальный островок появится рядом с основным."/>
                        </StackPanel></Border>
                        <Border x:Name="LegacyOrderCard" Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Порядок блоков" Style="{StaticResource Section}" Margin="0,0,0,5"/>
                            <TextBlock Text="Выберите блок и измените его место в HUD." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <ListBox x:Name="BlockOrderList" Height="108" SelectionChanged="OnOrderSelectionChanged" DisplayMemberPath="Label" AutomationProperties.Name="Порядок блоков HUD"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BlockUpButton" Content="↑ Выше" Click="OnBlockUp" Margin="0,0,8,0" AutomationProperties.Name="Переместить блок выше"/>
                                <Button x:Name="BlockDownButton" Content="↓ Ниже" Click="OnBlockDown" AutomationProperties.Name="Переместить блок ниже"/>
                            </StackPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0"><StackPanel>
                            <TextBlock Text="CPU, GPU и RAM" Style="{StaticResource Section}" Margin="0,0,0,5"/>
                            <StackPanel x:Name="LegacyMetricOrderControls">
                            <TextBlock Text="Выберите порядок показателей и их число в строке." Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                            <ListBox x:Name="MetricOrderList" Height="108" SelectionChanged="OnOrderSelectionChanged" DisplayMemberPath="Label" AutomationProperties.Name="Порядок CPU, GPU и RAM"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="MetricUpButton" Content="↑ Выше" Click="OnMetricUp" Margin="0,0,8,0" AutomationProperties.Name="Переместить показатель выше"/>
                                <Button x:Name="MetricDownButton" Content="↓ Ниже" Click="OnMetricDown" AutomationProperties.Name="Переместить показатель ниже"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="В строке" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="ColumnsOneRadio" Content="1" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Один показатель в строке"/>
                                <RadioButton x:Name="ColumnsTwoRadio" Content="2" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Два показателя в строке"/>
                                <RadioButton x:Name="ColumnsThreeRadio" Content="3" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Три показателя в строке"/>
                            </StackPanel>
                            <Button x:Name="ResetLayoutButton" Content="Вернуть исходную раскладку" HorizontalAlignment="Left" Click="OnResetLayout" Margin="0,8,0,0"/>

                        </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="ComponentsTab" Header="Показатели"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Игра и плавность" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Кадры, просадки и мини-графики в HUD." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="FpsCheckBox" Content="FPS" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="LowCheckBox" Content="1% Low" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="FrameTimeCheckBox" Content="Время кадра" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="ChartsCheckBox" Content="Мини-графики" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/></UniformGrid>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Процессор, видеокарта и память" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Нагрузка и доступные аппаратные датчики." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="CpuCheckBox" Content="Нагрузка CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="CpuTemperatureCheckBox" Content="Температура CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="GpuCheckBox" Content="Нагрузка GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="GpuTemperatureCheckBox" Content="Температура GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="MemoryCheckBox" Content="Память RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="MemoryTemperatureCheckBox" Content="Температура RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/></UniformGrid>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Музыка и звук" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Управление плеером и системной громкостью Windows." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <CheckBox x:Name="MusicCheckBox" Content="Музыка" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <CheckBox x:Name="VolumeCheckBox" Content="Ползунок громкости" Checked="OnDraftChanged" Unchecked="OnDraftChanged"
                                      ToolTip="Показывает ползунок и кнопку отключения звука в HUD."/>
                            <CheckBox x:Name="VolumeWheelCheckBox" Content="Громкость колёсиком" Checked="OnDraftChanged" Unchecked="OnDraftChanged"
                                      ToolTip="Меняет громкость, когда курсор наведён на островок. Работает и со скрытым ползунком."/>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Время и питание" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Батарея автоматически скрывается при работе от сети." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="TimeCheckBox" Content="Время" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="DateCheckBox" Content="Дата" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="BatteryCheckBox" Content="Батарея" Checked="OnDraftChanged" Unchecked="OnDraftChanged" ToolTip="Автоматически скрывается при работе от сети."/></UniformGrid>
                        </StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                    <TabItem x:Name="PlacementTab" Header="Положение"/>
                    <TabItem x:Name="ProfilesTab" Header="Профили игр"/>
                    <TabItem x:Name="ApplicationTab" Header="Приложение"/>
                </TabControl>
            </Grid>
            <Border x:Name="PreviewPane" Grid.Column="4" Style="{StaticResource SectionCard}" Padding="14" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Предпросмотр" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ExpandPreviewButton" Grid.Column="1" Content="Крупнее" Click="OnExpandPreview" Padding="8,4"
                                MinHeight="26" FontSize="12" Margin="5,0,0,0"/>
                    </Grid>
                    <Border x:Name="PreviewSurface" Grid.Row="1" CornerRadius="9" Padding="8" Height="225" ClipToBounds="True" SizeChanged="OnPreviewHostSizeChanged">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PreviewBackdrop}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=LightPreviewRadio}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PreviewLightBackdrop}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style></Border.Style>
                        <Image x:Name="HudPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Предпросмотр текущего оформления HUD"/>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,5,0,0">
                        <TextBlock Text="Фон" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="DarkPreviewRadio" Content="Тёмный" GroupName="PreviewBackdrop" IsChecked="True" FontSize="12" Margin="0,0,9,0"/>
                        <RadioButton x:Name="LightPreviewRadio" Content="Светлый" GroupName="PreviewBackdrop" FontSize="12" Margin="0"/>
                    </WrapPanel>
                    <TextBlock x:Name="PreviewDataCaption" Grid.Row="3" Text="Демонстрационные данные" Style="{StaticResource Caption}" FontSize="12" Margin="0,7,0,0"/>
                    <TextBlock x:Name="AlertPreviewCaption" Grid.Row="4" Text="Пример маркера предупреждения" Foreground="#DCC591" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="PreviewDetails" Grid.Row="5">
                        <TextBlock x:Name="PreviewSizeText" Style="{StaticResource Caption}" FontSize="12" Margin="0,5,0,0" ToolTip="Размер при масштабе Windows 100%."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#141A21" BorderBrush="#283540" BorderThickness="0,1,0,0" Padding="22,12" Margin="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6D7D8E" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource EditorMuted}" FontSize="13"
                               VerticalAlignment="Center" Text="Настройки сохранены" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <Button x:Name="CancelDraftButton" Grid.Column="1" Content="Отмена" IsCancel="True" MinWidth="88"/>
                <Button x:Name="SaveDraftButton" Grid.Column="3" Content="Сохранить" IsDefault="True" Click="OnSave"
                        MinWidth="112" Style="{StaticResource PrimaryButton}" ToolTip="Сохранить настройки (Ctrl+S)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
