<Window x:Class="Luma.Island.HudEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки · Luma Island" Width="1120" Height="780" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#111A20"
        Foreground="#EEF3F5" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnSettingsKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorMint" Color="#A6E8CF"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB8C1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#28353D"/>
            <Setter Property="Foreground" Value="#EEF3F5"/>
            <Setter Property="BorderBrush" Value="#40505A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#A6E8CF"/>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#35484F"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1A2B2E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.36"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="CheckSurface" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Background="#18252A" BorderBrush="#6C838C" BorderThickness="1" CornerRadius="3">
                        <Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 11,2" Stroke="#163027" StrokeThickness="1.7"
                              Width="10" Height="9" Stretch="Uniform" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckSurface" Property="Background" Value="#A6E8CF"/>
                        <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#A6E8CF"/>
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#C6FFE7"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#A6E8CF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,14,5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse x:Name="RadioSurface" Stroke="#718991" StrokeThickness="1" Fill="#18252A"/>
                        <Ellipse x:Name="RadioMark" Fill="#A6E8CF" Width="6" Height="6" Visibility="Collapsed"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="RadioSurface" Property="Stroke" Value="#A6E8CF"/>
                        <Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioSurface" Property="Stroke" Value="#C6FFE7"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioSurface" Property="Stroke" Value="#A6E8CF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                           Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="22" Margin="2,0">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#45605F" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30">
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" VerticalAlignment="Center" Background="#83CBB1" CornerRadius="2"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="15" Height="28" Cursor="Hand">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Ellipse Width="12" Height="12" Fill="#C1F2DF"/>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" VerticalAlignment="Center" Background="#3B4A53" CornerRadius="2"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#121A20"/>
            <Setter Property="Foreground" Value="#E1E9ED"/>
            <Setter Property="BorderBrush" Value="#35434C"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="Foreground" Value="#E1E9ED"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#2B4640"/>
                            <Setter Property="Foreground" Value="#C5F3DF"/>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <ContentPresenter ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9DAEB8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,9,0,11" Margin="0,0,24,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#BEF0DA"/>
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#A6E8CF"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DrawingBrush x:Key="PreviewBackdrop" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#202D32" Geometry="M0,0 H28 V28 H0 Z"/>
                <GeometryDrawing Brush="#26353A" Geometry="M0,0 H14 V14 H0 Z M14,14 H28 V28 H14 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#19242B"/><Setter Property="BorderBrush" Value="#293A43"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="18"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F1F3"/><Setter Property="Background" Value="#101A21"/>
            <Setter Property="BorderBrush" Value="#354B56"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#BEF0DA"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A6E8CF"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8F1F3"/><Setter Property="Background" Value="#17262E"/>
            <Setter Property="BorderBrush" Value="#354B56"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><ToggleButton Focusable="False" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="7">
                            <Grid Margin="10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                <Path Grid.Column="1" Data="M1,1 L5,5 L9,1" Stroke="#B6D2D1" StrokeThickness="1.3" Width="9" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                    <Border Background="#17262E" BorderBrush="#49616B" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A6E8CF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8F1F3"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ChoiceSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#2A4544"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#AEBEC6"/><Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavigationSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#29453F"/><Setter Property="Foreground" Value="#C5F4DE"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#23363B"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="#A6E8CF"/><Setter TargetName="NavigationSurface" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="24,20,24,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Вид HUD, поведение и профили игр." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="TogglePreviewButton" Grid.Column="1" Content="Предпросмотр" Click="OnTogglePreview" Margin="12,0,12,0" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#243A33" CornerRadius="7" Padding="11,7" VerticalAlignment="Center" MaxWidth="230">
                <TextBlock x:Name="TargetNameText" Foreground="#BBEBD5" FontSize="12" AutomationProperties.Name="Куда сохраняются настройки"/>
            </Border>
        </Grid>
        <Grid x:Name="SettingsBody" Grid.Row="1" Margin="18,0,18,0" SizeChanged="OnSettingsBodySizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewGapColumn" Width="18"/><ColumnDefinition x:Name="PreviewColumn" Width="270"/></Grid.ColumnDefinitions>
            <Border Background="#172229" CornerRadius="12" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="1,0,1,12"><TextBlock Text="Поиск по настройкам" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,7"/>
                        <TextBox x:Name="SettingsSearchBox" MaxLength="128" TextChanged="OnSearchChanged" AutomationProperties.Name="Поиск разделов настроек" ToolTip="Название раздела или настройки · Ctrl+F"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="SettingsNavigation" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}"
                                 SelectionChanged="OnNavigationChanged" AutomationProperties.Name="Разделы настроек">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoSearchResults" Text="Ничего не найдено. Попробуй другое слово." Style="{StaticResource Caption}" Margin="9,16" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="SettingsContentPanel" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,2,0,15"><TextBlock x:Name="ActiveSectionTitle" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActiveSectionDescription" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                </StackPanel>
                <TabControl x:Name="EditorTabs" Grid.Row="1" SelectionChanged="OnEditorTabChanged">
                    <TabItem x:Name="AppearanceTab" Header="Внешний вид"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Размер и фон" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CompactCheckBox" Content="Компактная капсула" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="GlassRadio" Content="Стекло" GroupName="SurfaceMode" Checked="OnDraftChanged"/>
                                <RadioButton x:Name="MatteRadio" Content="Матовое" GroupName="SurfaceMode" Checked="OnDraftChanged"/>
                            </StackPanel>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Прозрачность фона"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TransparencySlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="TransparencySlider" Minimum="0" Maximum="95" ValueChanged="OnDraftChanged"
                                    IsEnabled="{Binding IsChecked, ElementName=GlassRadio}" AutomationProperties.Name="Прозрачность фона, проценты"/>
                            <TextBlock Text="Текст и кнопки остаются непрозрачными." Style="{StaticResource Caption}"/>
                            <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Масштаб всего HUD"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="ScaleSlider" Minimum="75" Maximum="150" ValueChanged="OnDraftChanged" AutomationProperties.Name="Масштаб HUD, проценты"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Размер текста"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TextScaleSlider, StringFormat={}{0:0}%}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="TextScaleSlider" Minimum="80" Maximum="130" ValueChanged="OnDraftChanged" AutomationProperties.Name="Размер текста, проценты"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Расстояния между блоками"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0}}" Foreground="#BEEBD6"/>
                            </Grid>
                            <Slider x:Name="SpacingSlider" Minimum="2" Maximum="12" ValueChanged="OnDraftChanged" AutomationProperties.Name="Расстояния между блоками"/>

                        </StackPanel></Border>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="AlertsTab" Header="Предупреждения">                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <StackPanel>
                            <CheckBox x:Name="AlertsEnabledCheckBox" Content="Тихие предупреждения" FontSize="15" FontWeight="SemiBold" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <TextBlock Text="Небольшой цветной маркер в HUD. Без звука и всплывающих окон." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            <StackPanel x:Name="AlertRulesPanel" IsEnabled="{Binding IsChecked, ElementName=AlertsEnabledCheckBox}">
                                <TextBlock Text="Температура" Style="{StaticResource Section}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertCpuCheckBox" Content="CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=CpuThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="CpuThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertCpuCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры CPU, градусы Цельсия"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertGpuCheckBox" Content="GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=GpuThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GpuThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertGpuCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры GPU, градусы Цельсия"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AlertMemoryCheckBox" Content="RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=MemoryThresholdSlider, StringFormat={}{0:0} °C}" Foreground="#BEEBD6" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="MemoryThresholdSlider" Minimum="30" Maximum="115" IsEnabled="{Binding IsChecked, ElementName=AlertMemoryCheckBox}"
                                        ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог температуры RAM, градусы Цельсия"/>
                                <TextBlock Text="Выбери пороги для своего железа. Температура должна держаться выше порога несколько секунд; при отсутствии датчика предупреждение не появляется."
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                <TextBlock Text="Просадки в игре" Style="{StaticResource Section}"/>
                                <CheckBox x:Name="AlertStuttersCheckBox" Content="Серия задержавшихся кадров" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=AlertStuttersCheckBox}">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Кадр дольше"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FrameThresholdSlider, StringFormat={}{0:0} мс}" Foreground="#BEEBD6"/>
                                    </Grid>
                                    <Slider x:Name="FrameThresholdSlider" Minimum="10" Maximum="250" ValueChanged="OnDraftChanged" AutomationProperties.Name="Порог времени кадра, миллисекунды"/>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Таких кадров за 2 секунды"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=StutterCountSlider, StringFormat={}{0:0}}" Foreground="#BEEBD6"/>
                                    </Grid>
                                    <Slider x:Name="StutterCountSlider" Minimum="2" Maximum="10" LargeChange="1" ValueChanged="OnDraftChanged" AutomationProperties.Name="Количество медленных кадров за две секунды"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#202C30" CornerRadius="8" Padding="12" Margin="0,18,0,12">
                                <TextBlock Text="Включённые правила используют соответствующие измерения, даже если сами числа скрыты. Частота опроса остаётся прежней. Датчики CPU / RAM требуют настроенного модуля датчиков."
                                           Style="{StaticResource Caption}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="LayoutTab" Header="Раскладка"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Отдельные островки" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Показатели CPU, GPU и RAM остаются в основном островке. Музыку и громкость можно вынести в отдельный и перемещать независимо. Их включение остаётся в разделе «Показатели»." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <CheckBox x:Name="DetachedMusicCheckBox" Content="Музыка и громкость в отдельном островке" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                            <TextBlock Text="Прозрачность и масштаб общие. Скрытие в трей и пропуск кликов действуют на оба островка. Перетаскивайте за фон; закрепление защищает оба положения." Style="{StaticResource Caption}" Margin="0,7,0,10"/>
                            <Button x:Name="ResetMusicPositionButton" Content="Сбросить положение музыки" Click="OnResetMusicPosition" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecked, ElementName=DetachedMusicCheckBox}" ToolTip="После сохранения музыкальный островок появится рядом с основным."/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Порядок блоков и строки меняют свёрнутую капсулу. Раскрытая панель сохраняет карточки и управление музыкой." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                            <TextBlock Text="Порядок блоков" Style="{StaticResource Section}"/>
                            <ListBox x:Name="BlockOrderList" Height="108" SelectionChanged="OnOrderSelectionChanged" DisplayMemberPath="Label" AutomationProperties.Name="Порядок блоков HUD"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BlockUpButton" Content="↑ Выше" Click="OnBlockUp" Margin="0,0,8,0" AutomationProperties.Name="Переместить блок выше"/>
                                <Button x:Name="BlockDownButton" Content="↓ Ниже" Click="OnBlockDown" AutomationProperties.Name="Переместить блок ниже"/>
                            </StackPanel>
                            <TextBlock Text="CPU, GPU и RAM" Style="{StaticResource Section}"/>
                            <TextBlock Text="Выбери порядок показателей и их число в строке." Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                            <ListBox x:Name="MetricOrderList" Height="108" SelectionChanged="OnOrderSelectionChanged" DisplayMemberPath="Label" AutomationProperties.Name="Порядок CPU, GPU и RAM"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="MetricUpButton" Content="↑ Выше" Click="OnMetricUp" Margin="0,0,8,0" AutomationProperties.Name="Переместить показатель выше"/>
                                <Button x:Name="MetricDownButton" Content="↓ Ниже" Click="OnMetricDown" AutomationProperties.Name="Переместить показатель ниже"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="В строке:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="ColumnsOneRadio" Content="1" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Один показатель в строке"/>
                                <RadioButton x:Name="ColumnsTwoRadio" Content="2" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Два показателя в строке"/>
                                <RadioButton x:Name="ColumnsThreeRadio" Content="3" GroupName="MetricColumns" Checked="OnDraftChanged" AutomationProperties.Name="Три показателя в строке"/>
                            </StackPanel>
                            <Button x:Name="ResetLayoutButton" Content="Вернуть исходную раскладку" HorizontalAlignment="Left" Click="OnResetLayout" Margin="0,8,0,0"/>

                        </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer></TabItem>
                    <TabItem x:Name="ComponentsTab" Header="Показатели"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Игра и плавность" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Кадры, просадки и графики в раскрытой панели." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="FpsCheckBox" Content="FPS" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="LowCheckBox" Content="1% Low" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="FrameTimeCheckBox" Content="Время кадра" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="ChartsCheckBox" Content="Мини-графики" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/></UniformGrid>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Процессор, видеокарта и память" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Нагрузка и доступные аппаратные датчики." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="CpuCheckBox" Content="Нагрузка CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="CpuTemperatureCheckBox" Content="Температура CPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="GpuCheckBox" Content="Нагрузка GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="GpuTemperatureCheckBox" Content="Температура GPU" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="MemoryCheckBox" Content="Память RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="MemoryTemperatureCheckBox" Content="Температура RAM" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/></UniformGrid>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Музыка и звук" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Название трека, управление плеером и громкость." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="MusicCheckBox" Content="Музыка" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="VolumeCheckBox" Content="Громкость" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/></UniformGrid>
                        </StackPanel></Border>                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="Время и питание" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Батарея автоматически скрывается при работе от сети." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                            <UniformGrid Columns="2"><CheckBox x:Name="TimeCheckBox" Content="Время" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="DateCheckBox" Content="Дата" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
<CheckBox x:Name="BatteryCheckBox" Content="Батарея" Checked="OnDraftChanged" Unchecked="OnDraftChanged" ToolTip="Автоматически скрывается при работе от сети."/></UniformGrid>
                        </StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                    <TabItem x:Name="PlacementTab" Header="Положение"/>
                    <TabItem x:Name="ProfilesTab" Header="Профили игр"/>
                    <TabItem x:Name="ApplicationTab" Header="Приложение"/>
                </TabControl>
            </Grid>
            <Border x:Name="PreviewPane" Grid.Column="4" Style="{StaticResource SectionCard}" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ПРЕДПРОСМОТР" Foreground="#A6C1B6" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ExpandPreviewButton" Grid.Column="1" Content="Крупнее" Click="OnExpandPreview" Padding="8,4" MinHeight="24" FontSize="11" Background="Transparent" Margin="5,0,0,0"/>
                    </Grid>
                    <Border x:Name="PreviewSurface" Background="{StaticResource PreviewBackdrop}" CornerRadius="8" Padding="8" Height="260" SizeChanged="OnPreviewHostSizeChanged">
                        <Image x:Name="HudPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Предпросмотр текущего оформления HUD"/>
                    </Border>
                    <TextBlock x:Name="PreviewDataCaption" Text="Предпросмотр уменьшен; данные приведены для примера." Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0"/>
                    <TextBlock x:Name="AlertPreviewCaption" Text="Маркер предупреждения показан для примера." Foreground="#DCC591" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="PreviewDetails">
                        <TextBlock x:Name="PreviewSizeText" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" ToolTip="Размер при масштабе Windows 100%."/>
                        <Border Height="1" Background="#304047" Margin="0,14,0,12"/>
                        <TextBlock Text="До сохранения игровой HUD остаётся прежним." Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#10181E" BorderBrush="#27373F" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,18,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#ADBFC7" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Text="Изменения применятся после сохранения." AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CancelDraftButton" Grid.Column="1" Content="Отмена" IsCancel="True" MinWidth="88"/>
                <Button x:Name="SaveDraftButton" Grid.Column="3" Content="Сохранить" IsDefault="True" Click="OnSave" MinWidth="104" Background="#A6E8CF" Foreground="#14241E" BorderBrush="#A6E8CF"/>
            </Grid>
        </Border>
    </Grid>
</Window>
