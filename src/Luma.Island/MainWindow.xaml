<Window x:Class="Luma.Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Island" Icon="/Luma.Island;component/Assets/Luma.ico" Width="408" Height="80"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnCapsuleEditorKeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource GlassTextShadow}"/>
        </Style>
        <SolidColorBrush x:Key="Mint" Color="#A6E8CF"/>
        <SolidColorBrush x:Key="Muted" Color="#989FA8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F3F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C7CFD5"/>
        <SolidColorBrush x:Key="Subtle" Color="#7F8A94"/>
        <SolidColorBrush x:Key="SurfaceFill" Color="#161A1F"/>
        <SolidColorBrush x:Key="SurfaceStroke" Color="#343A41"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#293038"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#343D45"/>
        <SolidColorBrush x:Key="AlbumSurface" Color="#25332E"/>
        <SolidColorBrush x:Key="VolumeTrack" Color="#343B42"/>
        <Style x:Key="KeyboardFocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="{StaticResource Mint}" BorderThickness="1" CornerRadius="11" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center" Background="{StaticResource Mint}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="11" Height="11" Fill="#ECF8F3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center" Background="{DynamicResource VolumeTrack}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="IslandSurface" Width="376" Height="56" VerticalAlignment="Top"
                Margin="12" Background="{DynamicResource SurfaceFill}" BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="1"
                CornerRadius="16" ClipToBounds="True" PreviewMouseLeftButtonDown="OnSurfacePointerDown"
                PreviewMouseWheel="OnSurfaceMouseWheel">
            <Border.ContextMenu>
                <ContextMenu>
                    <Separator/>
                    <MenuItem Header="Выход" Click="OnExit"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid x:Name="CompactView" Margin="13,6" AutomationProperties.Name="Luma Island">
                    <Grid x:Name="CompactContentGrid" Width="348">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HudHeaderRow" Height="24"/>
                            <RowDefinition x:Name="HudMetricsRow" Height="0"/>
                            <RowDefinition x:Name="HudMusicRow" Height="44"/>
                            <RowDefinition x:Name="ChartsRow" Height="0"/>
                            <RowDefinition x:Name="FrameTimeRow" Height="0"/>
                            <RowDefinition x:Name="VolumeRow" Height="0"/>
                            <RowDefinition x:Name="FooterRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="HudHeader" UseLayoutRounding="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CompactFrameColumn" Width="*"/>
                                <ColumnDefinition x:Name="CompactClockColumn" Width="Auto"/>
                                <ColumnDefinition x:Name="CompactBatteryColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="CompactFrameStats" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="CompactFpsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="CompactFps" Text="—" FontSize="34" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactFpsUnit" Text="FPS" FontSize="11" Foreground="{DynamicResource Muted}"
                                           Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <StackPanel x:Name="CompactLowPanel" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="1% Low" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="CompactOnePercentLow" Text="—" FontSize="18" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="CompactClock" Grid.Column="1" Text="--:--" FontSize="13" Margin="6,0,8,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CompactBattery" Grid.Column="2" Text="—" FontSize="11" Margin="4,0,8,0"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <UniformGrid x:Name="CompactPerformance" Grid.Row="1" Columns="3"
                                     Height="28" Margin="0,6,0,6" Visibility="Collapsed">
                            <TextBlock x:Name="CompactCpu" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" Visibility="Collapsed"/>
                            <TextBlock x:Name="CompactGpu" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" Visibility="Collapsed"/>
                            <TextBlock x:Name="CompactMemory" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" Visibility="Collapsed"/>
                        </UniformGrid>
                        <Grid x:Name="CompactMusicRow" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CompactArtworkColumn" Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CompactArtworkFrame" IsHitTestVisible="False" Width="29" Height="29" CornerRadius="9" Background="{DynamicResource AlbumSurface}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="CompactFallback" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{StaticResource Mint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="CompactArtwork" Width="29" Height="29" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Image.Clip><RectangleGeometry Rect="0,0,29,29" RadiusX="9" RadiusY="9"/></Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="CompactMusicText" IsHitTestVisible="False" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactTitle" Text="Откройте музыку" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CompactArtist" Text="Системный плеер" FontSize="11" Foreground="{DynamicResource Muted}"
                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="CompactPlaybackControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CompactPreviousButton" Width="24" Height="28" Style="{StaticResource QuietButton}"
                                    IsEnabled="False" Click="OnPrevious"
                                    AutomationProperties.Name="Предыдущий трек" ToolTip="Предыдущий трек">
                                <Path Data="M 1,1 L 1,13 M 13,1 L 4,7 L 13,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="11" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="CompactPlayButton" Width="24" Height="28" Style="{StaticResource QuietButton}" Foreground="{StaticResource Mint}"
                                    IsEnabled="False" Click="OnTogglePlayback"
                                    AutomationProperties.Name="Воспроизвести" ToolTip="Воспроизвести / пауза">
                                <Path x:Name="CompactPlayIcon" Data="M 2,1 L 2,15 L 13,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="10" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="CompactNextButton" Width="24" Height="28" Style="{StaticResource QuietButton}"
                                    IsEnabled="False" Click="OnNext"
                                    AutomationProperties.Name="Следующий трек" ToolTip="Следующий трек">
                                <Path Data="M 13,1 L 13,13 M 1,1 L 10,7 L 1,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="11" Stretch="Uniform"/>
                            </Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ChartsPanel" Grid.Row="3" Margin="0,3" Visibility="Collapsed" IsVisibleChanged="OnChartsVisibleChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/><RowDefinition x:Name="ChartGapRow" Height="6"/>
                                <RowDefinition x:Name="ChartSecondRow" Height="64"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="CpuChartCard" Grid.Row="0" Grid.Column="0" CornerRadius="9" Background="#18000000" Padding="9,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="13"/></Grid.RowDefinitions>
                                    <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="CpuChartValue" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
                                    <Canvas x:Name="CpuChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                                        <Path x:Name="CpuChartGrid" Stroke="{DynamicResource Subtle}" Opacity="0.18" StrokeThickness="0.6"/>
                                        <Path x:Name="CpuChartLine" Stroke="{StaticResource Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="CpuChartScale" Grid.Row="2" Text="0–100%" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                                    <TextBlock Grid.Row="2" Text="до 2 мин" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="GpuChartCard" Grid.Row="0" Grid.Column="2" CornerRadius="9" Background="#18000000" Padding="9,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="13"/></Grid.RowDefinitions>
                                    <TextBlock Text="GPU" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="GpuChartValue" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
                                    <Canvas x:Name="GpuChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                                        <Path x:Name="GpuChartGrid" Stroke="{DynamicResource Subtle}" Opacity="0.18" StrokeThickness="0.6"/>
                                        <Path x:Name="GpuChartLine" Stroke="{StaticResource Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock Grid.Row="2" Text="0–100%" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                                    <TextBlock Grid.Row="2" Text="до 2 мин" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="MemoryChartCard" Grid.Row="2" Grid.Column="0" CornerRadius="9" Background="#18000000" Padding="9,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="13"/></Grid.RowDefinitions>
                                    <TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="MemoryChartValue" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
                                    <Canvas x:Name="MemoryChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                                        <Path x:Name="MemoryChartGrid" Stroke="{DynamicResource Subtle}" Opacity="0.18" StrokeThickness="0.6"/>
                                        <Path x:Name="MemoryChartLine" Stroke="{StaticResource Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock Grid.Row="2" Text="0–100%" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                                    <TextBlock Grid.Row="2" Text="до 2 мин" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="FpsChartCard" Grid.Row="2" Grid.Column="2" CornerRadius="9" Background="#18000000" Padding="9,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="13"/></Grid.RowDefinitions>
                                    <TextBlock Text="FPS" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="FpsChartValue" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Mint}"/>
                                    <Canvas x:Name="FpsChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                                        <Path x:Name="FpsChartGrid" Stroke="{DynamicResource Subtle}" Opacity="0.18" StrokeThickness="0.6"/>
                                        <Path x:Name="FpsChartLine" Stroke="{StaticResource Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="FpsChartScale" Grid.Row="2" Text="0–60 FPS" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                                    <TextBlock Grid.Row="2" Text="до 2 мин" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border x:Name="FrameTimeCard" Grid.Row="4" Margin="0,3" CornerRadius="9" Background="#18000000" Padding="9,4" Visibility="Collapsed"
                                IsVisibleChanged="OnFrameTimeVisibleChanged">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="13"/></Grid.RowDefinitions>
                                <TextBlock Text="Время кадра" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="FrameTimeValue" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
                                <Canvas x:Name="FrameTimeCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="OnFrameTimeSizeChanged">
                                    <Path x:Name="FrameTimeGrid" Stroke="{DynamicResource Subtle}" Opacity="0.18" StrokeThickness="0.6"/>
                                    <Path x:Name="FrameTimeLine" Stroke="{StaticResource Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                                <TextBlock x:Name="FrameTimeScale" Grid.Row="2" Text="0–16 мс" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                                <TextBlock x:Name="FrameTimePeak" Grid.Row="2" Text="до 10 с" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="CompactVolume" Grid.Row="5" Margin="0,1,0,1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Width="24" Height="22" Style="{StaticResource QuietButton}"
                                    Click="OnMute" AutomationProperties.Name="Выключить звук" ToolTip="Включить / выключить звук">
                                <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                            <Slider x:Name="VolumeControl" Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource VolumeSlider}"
                                    ValueChanged="OnVolumeChanged" AutomationProperties.Name="Системная громкость"/>
                            <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="—" FontSize="11" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="DateLabel" Grid.Row="6" Margin="1,2,1,0" FontSize="11"
                                   Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <Ellipse x:Name="QuietAlertIndicator" Width="7" Height="7" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,8,10,0" Fill="#F3BE64" Visibility="Collapsed"
                         AutomationProperties.Name="Предупреждение HUD"/>
            </Grid>
        </Border>
        <Border x:Name="CapsuleMoveGrip" Visibility="Collapsed" Width="14" Height="36"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,22,0,0"
                Background="#E8213432" BorderBrush="#659C8D" BorderThickness="1" CornerRadius="5"
                Cursor="SizeAll" PreviewMouseLeftButtonDown="OnCapsuleGripDown"
                ToolTip="Переместить всю капсулу" AutomationProperties.Name="Переместить всю капсулу">
            <TextBlock Text="⋮" Foreground="{StaticResource Mint}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="CapsuleEditBar" Visibility="Collapsed" Height="32" Margin="16,0,16,6"
                Background="#F01A252C" BorderBrush="#45655D" BorderThickness="1" CornerRadius="9"
                VerticalAlignment="Bottom" Padding="9,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Готово" Width="64" Height="25" Foreground="{StaticResource Mint}"
                        Style="{StaticResource QuietButton}" Click="OnCapsuleEditDone"/>
                <Button DockPanel.Dock="Right" Content="Отмена" Width="62" Height="25"
                        Style="{StaticResource QuietButton}" Click="OnCapsuleEditCancel"/>
                <Button DockPanel.Dock="Right" Content="Сброс" Width="56" Height="25" ToolTip="Собрать блоки в одну капсулу в исходном порядке"
                        AutomationProperties.Name="Сбросить раскладку" Style="{StaticResource QuietButton}" Click="OnCapsuleEditReset"/>
                <TextBlock Text="Перетащите блок" Foreground="#D9E9E5" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
