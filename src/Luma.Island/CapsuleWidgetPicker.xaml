<UserControl x:Class="Luma.Island.CapsuleWidgetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="352" UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI" KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="Блоки HUD">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEF5F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="Margin" Value="0,0,3,2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Option" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Mark" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="#677F83"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 2,6 L 5,9 L 10,3" Stroke="#152C27" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Option" Property="Background" Value="#27363E"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Option" Property="BorderBrush" Value="#9DE6D1"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Mark" Property="Background" Value="#9DE6D1"/>
                        <Setter TargetName="Mark" Property="BorderBrush" Value="#9DE6D1"/>
                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#F51A252C" BorderBrush="#45655D" BorderThickness="1" CornerRadius="12" Padding="12,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                <TextBlock Text="Блоки HUD" Foreground="#F2F7F5" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Отметьте блоки для текущей раскладки." Foreground="#B2C6C2" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="WidgetGroups"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
