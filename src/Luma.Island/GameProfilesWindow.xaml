<Window x:Class="Luma.Island.GameProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профили игр · Luma Island" Width="720" Height="570" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#161A1F" Foreground="#EDF2F5" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#2A353D"/>
            <Setter Property="Foreground" Value="#EDF2F5"/>
            <Setter Property="BorderBrush" Value="#46535D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#37464E"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1B2C31"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#10161B"/>
            <Setter Property="Foreground" Value="#EDF2F5"/>
            <Setter Property="BorderBrush" Value="#46535D"/>
            <Setter Property="CaretBrush" Value="#A6E8CF"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <CheckBox x:Name="AutoSwitchCheckBox" Content="Автоматически переключать профили игр"
                      Foreground="#EDF2F5" FontSize="15" VerticalContentAlignment="Center"/>
            <TextBlock Text="При выключении текущий вид HUD остаётся на месте."
                       Foreground="#ADB9C2" FontSize="12" Margin="23,7,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <ListBox x:Name="ProfileList" SelectionChanged="OnSelectionChanged"
                             AutomationProperties.Name="Профили игр" Background="#10161B" Foreground="#EDF2F5"
                             BorderBrush="#384651" Padding="4" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,8"/>
                                <Setter Property="Foreground" Value="#EDF2F5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2E4A43"/>
                                        <Setter Property="Foreground" Value="#D6F5E7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoProfilesMessage" Text="Пока нет профилей игр." Foreground="#ADB9C2"
                               Margin="14" IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="AddProfileButton" Content="Добавить игру…" Click="OnAdd"/>
                    <Button x:Name="RemoveProfileButton" Grid.Column="2" Content="Удалить" Click="OnRemove" IsEnabled="False"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock x:Name="EmptyEditorMessage" Text="Выберите .exe игры. Новый профиль запомнит текущие настройки HUD."
                               Foreground="#ADB9C2" Margin="0,5,0,0"/>
                    <StackPanel x:Name="ProfileEditor" Visibility="Collapsed">
                        <TextBlock Text="Название профиля" Foreground="#ADB9C2" Margin="0,0,0,5"/>
                        <TextBox x:Name="ProfileNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                 AutomationProperties.Name="Название профиля"/>
                        <TextBlock Text="Исполняемый файл игры" Foreground="#ADB9C2" Margin="0,14,0,5"/>
                        <TextBox x:Name="ProfilePathBox" Text="{Binding ExecutablePath}" IsReadOnly="True"
                                 AutomationProperties.Name="Исполняемый файл игры" TextWrapping="Wrap"
                                 MinHeight="56" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        <Button x:Name="ChangeExecutableButton" Content="Выбрать другой .exe…" Click="OnChangeExecutable"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="Сохранённый HUD" Foreground="#ADB9C2" Margin="0,18,0,6"/>
                        <TextBlock x:Name="ProfileSummary" Text="{Binding Summary}"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <Button x:Name="CopyCurrentHudButton" Grid.Row="1" Content="Сохранить текущий HUD в профиль" Click="OnCopyCurrentHud"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=ProfileEditor}"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#B9D7C9" Margin="0,14,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Изменения вступят в силу после сохранения."
                       Foreground="#ADB9C2" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена" IsCancel="True" MinWidth="86"/>
            <Button x:Name="SaveButton" Grid.Column="3" Content="Сохранить" IsDefault="True" Click="OnSave"
                    MinWidth="102" Background="#A6E8CF" Foreground="#14241E" BorderBrush="#A6E8CF"/>
        </Grid>
    </Grid>
</Window>
