<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PublishedAppDirectory Condition="'$(PublishedAppDirectory)' == ''">$(MSBuildThisFileDirectory)../../artifacts/Luma-Island-0.14.0</PublishedAppDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Luma.Island"><HintPath>$(PublishedAppDirectory)/Luma.Island.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>$(PublishedAppDirectory)/WinRT.Runtime.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
