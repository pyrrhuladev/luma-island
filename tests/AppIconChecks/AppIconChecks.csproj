<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishedAppDirectory Condition="'$(PublishedAppDirectory)' == ''">$(MSBuildThisFileDirectory)../../artifacts/Luma-Island</PublishedAppDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Luma.Island"><HintPath>$(PublishedAppDirectory)/Luma.Island.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="ValidatePublishedAppDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(PublishedAppDirectory)/Luma.Island.dll') Or !Exists('$(PublishedAppDirectory)/Luma.Island.exe')"
           Text="Published Luma.Island.dll/exe was not found. Run tools/Test.ps1 or pass -p:PublishedAppDirectory=&lt;published-app-directory&gt;." />
  </Target>
  <Target Name="CopyExecutableFixtureToBuild" AfterTargets="Build">
    <Copy SourceFiles="$(PublishedAppDirectory)/Luma.Island.exe" DestinationFiles="$(TargetDir)Published-Luma.Island.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyExecutableFixtureToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishedAppDirectory)/Luma.Island.exe" DestinationFiles="$(PublishDir)Published-Luma.Island.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
